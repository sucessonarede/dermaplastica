# ------------------------------------------------------------------
# Dermalift — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores.
#   cp .env.example .env
# ------------------------------------------------------------------

# Banco de dados (Supabase → Settings → Database → Connection string → URI)
# Local: pode usar a conexão direta (porta 5432).
# Vercel: use OBRIGATORIAMENTE a connection string do POOLER (porta 6543),
#         senão o serverless estoura o limite de conexões.
DATABASE_URL=postgresql://postgres.xxxxxxxx:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# Usada APENAS pelo "npm run db:push" (migrações precisam de session mode, porta 5432).
# Se não definir, o db:push usa a DATABASE_URL acima.
DIRECT_URL=postgresql://postgres.xxxxxxxx:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# Segredo dos cookies de sessão. Gere um valor aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# ------------------------------------------------------------------
# Supabase Storage (fotos de pacientes e imagens de produtos)
# Settings → API. A service_role key é SECRETA — nunca vai para o frontend.
# Se estas duas variáveis ficarem vazias em desenvolvimento, os arquivos são
# gravados na pasta local ./.local-storage (não funciona na Vercel).
# ------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=dermalift

# Prefixo (pasta) usado dentro do bucket
PRIVATE_OBJECT_DIR=private

# ------------------------------------------------------------------
# Opcionais (apenas desenvolvimento local)
# ------------------------------------------------------------------
PORT=5000
HOST=127.0.0.1
# LOCAL_STORAGE_DIR=.local-storage
# SESSION_STORE=postgres   # força sessão no Postgres também em dev
